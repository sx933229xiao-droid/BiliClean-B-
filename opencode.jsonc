{
  "$schema": "https://opencode.ai/config.json",

  /*
   * BiliClean OpenCode 项目级工作流配置
   * 工作流：Plan → Build → /verify → /review → /release
   * 原则：已存在有效配置优先保留，本文件为兼容合并版
   */

  "instructions": ["AGENTS.md"],

  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.env.example": "allow"
    },

    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",

    "webfetch": "allow",
    "websearch": "allow",

    "task": "allow",
    "question": "allow",

    "external_directory": "ask",
    "doom_loop": "ask",

    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "git branch*": "allow",

      "npm run verify*": "allow",
      "npm run check*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npm run package*": "allow",
      "node --test*": "allow",
      "node scripts/check.mjs*": "allow",
      "node scripts/build.mjs*": "allow",
      "node scripts/verify-dist.mjs*": "allow",

      "git commit*": "ask",

      "git push*": "deny",
      "git push --*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git clean -*": "deny",

      "npm publish*": "deny",

      "rm *": "deny",
      "rm -rf*": "deny"
    }
  },

  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 16000
  }
}
